# Configuração do webhook separado. A configuração pública do painel aparece ao final.
# Configure valores reais com segurança; não versione o arquivo .env.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_IDS=
HOST=127.0.0.1
PORT=3001

# Painel: normalmente gerados por npm run db:start em apps/painel/.env.local
# Somente chave anon pública; nunca service_role. Não copie valores de produção para testes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_LUMI_MODE=demo # opt-in para demonstração sem banco
